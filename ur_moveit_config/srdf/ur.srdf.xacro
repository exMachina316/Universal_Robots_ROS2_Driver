<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">

  <!-- robot name parameter -->
  <xacro:arg name="name" default="ur"/>
  <!-- parameters -->
  <xacro:arg name="prefix" default="" />

  <xacro:include filename="$(find ur_moveit_config)/srdf/ur_macro.srdf.xacro"/>

  <disable_collisions link1="slider_base" link2="base_link_inertia" reason="Adjacent" />
  <disable_collisions link1="slider_base" link2="base_link" reason="Adjacent" />
  <disable_collisions link1="slider_base" link2="linear_rail" reason="Adjacent" />

  <disable_collisions link1="base_link" link2="linear_rail" reason="Adjacent" />
  <disable_collisions link1="base_link" link2="linear_rail" reason="Adjacent" />
  <disable_collisions link1="base_link" link2="linear_rail" reason="Adjacent" />

  <disable_collisions link1="table1" link2="work_cell" reason="Adjacent" />
  <disable_collisions link1="table2" link2="work_cell" reason="Adjacent" />
  <disable_collisions link1="linear_rail" link2="work_cell" reason="Adjacent" />

  <disable_collisions link1="plc_linear_rail" link2="work_cell" reason="Adjacent" />

  <xacro:ur_srdf name="$(arg name)" prefix="$(arg prefix)"/>

</robot>
